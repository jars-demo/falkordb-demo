// Fraud ring: bank customers who look unrelated, but share phones, devices and addresses.
// Fictional data. Each statement ends with a semicolon.

CREATE
  (c1:Customer {name: 'R. Mehta', since: 2024}),
  (c2:Customer {name: 'L. Novak', since: 2024}),
  (c3:Customer {name: 'S. Okoye', since: 2024}),
  (c4:Customer {name: 'T. Brandt', since: 2019}),
  (c5:Customer {name: 'M. Silva', since: 2021}),
  (a1:Account {number: 'ACC-1001', balance: 120}),
  (a2:Account {number: 'ACC-1002', balance: 80}),
  (a3:Account {number: 'ACC-1003', balance: 95}),
  (a4:Account {number: 'ACC-2001', balance: 15400}),
  (a5:Account {number: 'ACC-3001', balance: 6200}),
  (phone:Phone {number: '+1-555-0142'}),
  (device:Device {id: 'android-7f3a'}),
  (addr:Address {line: '12 Harbor St, Unit 4'}),
  (addr2:Address {line: '88 Elm Road'}),
  (addr3:Address {line: '3 Lake View'}),
  (c1)-[:OWNS]->(a1),
  (c2)-[:OWNS]->(a2),
  (c3)-[:OWNS]->(a3),
  (c4)-[:OWNS]->(a4),
  (c5)-[:OWNS]->(a5),
  (c1)-[:USES_PHONE]->(phone),
  (c2)-[:USES_PHONE]->(phone),
  (c2)-[:USES_DEVICE]->(device),
  (c3)-[:USES_DEVICE]->(device),
  (c1)-[:LIVES_AT]->(addr),
  (c3)-[:LIVES_AT]->(addr),
  (c4)-[:LIVES_AT]->(addr2),
  (c5)-[:LIVES_AT]->(addr3),
  (a4)-[:TRANSFERRED_TO {amount: 4800, day: 3}]->(a1),
  (a1)-[:TRANSFERRED_TO {amount: 4700, day: 4}]->(a2),
  (a2)-[:TRANSFERRED_TO {amount: 4600, day: 5}]->(a3),
  (a3)-[:TRANSFERRED_TO {amount: 4500, day: 6}]->(a1),
  (a5)-[:TRANSFERRED_TO {amount: 120, day: 2}]->(a4);
