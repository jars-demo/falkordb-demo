# falkordb-demo settings. Easiest: run `python scripts/setup.py`, which writes .env for you.
# Or copy this file to .env and uncomment what you need. With no .env at all, everything runs
# locally with no account and no API key.

###############################################################################
# Where FalkorDB is when the backend runs on your machine
#   - localhost:6379    the falkordb container from docker-compose.yml (default)
#   - a cloud host      FalkorDB Cloud: copy host, port, username and password from
#                       https://app.falkordb.cloud
# Inside Docker these are ignored: the backend container always uses the falkordb container.
###############################################################################

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
#FALKORDB_USERNAME=
#FALKORDB_PASSWORD=

###############################################################################
# Optional: free Groq key for the GraphRAG step
# Get one at https://console.groq.com/keys. Only GraphRAG uses it; everything else needs no key.
# Embeddings run locally (fastembed), because Groq has no embedding models.
###############################################################################

#LLM_API_KEY="gsk_..."
#LLM_MODEL="groq/openai/gpt-oss-120b"
